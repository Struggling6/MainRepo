        dropout=FloatRange(0.1, 0.35),

        pos_weight_cap=FloatRange(1.0, 6.0, log=True)
    ),

    # ── PatchTST Config ─────────────────────────────────────────────────────── #

    patchtst=PatchTSTOptunaConfig(
